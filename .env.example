# Location: menu-standards-app/.env.example
#
# Every setting the app needs, with no real values.
# On your computer: copy this file to .env.local and fill in the values there.
# On Vercel: add the same names under Settings, Environment Variables.
# Never put real values in this file. It is saved to GitHub.

# Password gate (Phase 1)
# Fingerprint of the admin password, created on your computer with
# scripts/hash-password.mjs. The password itself is never stored.
ADMIN_PASSWORD_HASH=
# Random key, at least 32 characters, that signs the 7-day pass.
GATE_SECRET=

# AI (Phase 3)
# A key from the Menu Standards project in OpenAI, restricted to Responses
# only. Your computer uses the local key; Vercel Production holds the
# production key. Never the same key in both places.
OPENAI_API_KEY=

# File storage (Phase 3)
# Nothing to fill in here. On Vercel, storage signs in with self-renewing
# credentials that Vercel supplies once the store is connected
# (BLOB_STORE_ID, BLOB_WEBHOOK_PUBLIC_KEY, and VERCEL_OIDC_TOKEN), and no
# permanent storage key is used (decision 44). How this computer reaches
# storage for local testing is settled with the Milestone 1 test harness.