# Location: menu-standards-app/.gitignore
#
# Files and folders Git must never save or upload to GitHub.
# Pattern rules: https://git-scm.com/docs/gitignore

# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# Production build and test coverage
/build
/coverage

# Secrets
# Every .env file is blocked because these files hold API keys and passwords.
# The one exception is .env.example, which lists setting names with no values.
.env*
!.env.example
*.pem

# Private test data
# Real restaurant menus used for local testing are customer data.
# Keep them in this folder so they never reach GitHub.
/private/

# Vercel local project link
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
.pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini